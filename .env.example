HTTP_PORT=8080
POSTGRES_DB=relay
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay-local-change-me
DJANGO_SECRET_KEY=local-development-only-change-before-public-deployment
ALLOWED_HOSTS=localhost,127.0.0.1
# Admin URL path on this site's domain, e.g. control-panel/ (not a full URL).
DJANGO_ADMIN_URL=admin/
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Anthropic key for ORA. Optional locally: leave it blank and ORA uses local guidance.
# Required by compose.prod.yaml (set it in .env.prod).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AI_DAILY_REQUEST_LIMIT=100
COOKIE_SECURE=false
# Optional player accounts (email + password). With EMAIL_HOST blank, verification and
# password-reset emails are printed to the API log instead: docker compose logs api
# Required by compose.prod.yaml (set them in .env.prod).
# Public origin used in emailed links, e.g. https://relay.example.com (no path).
PUBLIC_SITE_URL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# STARTTLS, usually port 587. For implicit TLS on port 465: EMAIL_USE_TLS=false, EMAIL_USE_SSL=true.
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL="RELAY <no-reply@example.com>"
# Player feedback board. Staff emailed about every new submission (comma-separated).
# Blank sends no notifications. Required by compose.prod.yaml.
STAFF_EMAILS=
# Feedback rate limits (whole numbers, at least 1 unless noted). Only accepted posts count.
# Seconds before the same network or player can post again (0 turns the cooldown off).
FEEDBACK_SUBMISSION_COOLDOWN_SECONDS=60
FEEDBACK_SUBMISSIONS_PER_IP_HOUR=10
# Per signed-in account, or per guest browser session.
FEEDBACK_SUBMISSIONS_PER_SUBMITTER_DAY=5
# Vote and unvote requests per network address.
FEEDBACK_VOTES_PER_IP_HOUR=300
# New upvotes one network can give a single idea per day (stops vote stuffing).
FEEDBACK_VOTES_PER_IDEA_PER_IP_DAY=5
# How long a solved CAPTCHA lets a browser session vote before it is asked again.
FEEDBACK_VOTER_CHECK_HOURS=24
# Spam filter: links allowed in a post's details (titles never allow links; 0 allows none),
# and comma-separated words or phrases that get a post rejected (whole words, any case).
FEEDBACK_MAX_LINKS=2
FEEDBACK_BLOCKED_WORDS=
# Local end-to-end tests only: the CAPTCHA also accepts the answer PASSED.
# Never set on a public site (refused together with COOKIE_SECURE=true; compose.prod.yaml never passes it).
CAPTCHA_TEST_MODE=false
